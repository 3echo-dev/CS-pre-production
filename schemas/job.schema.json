{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectSpec v1 (1-22)",
  "type": "object",
  "required": [
    "schemaVersion",
    "jobId",
    "client",
    "title",
    "kind",
    "driveFolder",
    "scriptFormat",
    "storyboardStyle",
    "hasTrailer",
    "inputs",
    "approvers",
    "requestedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "jobId": {
      "type": "string",
      "pattern": "^job-\\d{8}-[a-z0-9][a-z0-9-]*$"
    },
    "client": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "brand": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "preproduction",
        "postproduction"
      ]
    },
    "driveFolder": {
      "type": "string",
      "minLength": 1
    },
    "scriptFormat": {
      "enum": [
        "screenplay",
        "av_script"
      ]
    },
    "storyboardStyle": {
      "enum": [
        "sketches",
        "live_pictures",
        "cartoon_animation"
      ]
    },
    "hasTrailer": {
      "type": "boolean"
    },
    "shootDays": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Shoot days once the person answers; 0 means fully AI-generated with no live shoot; null until answered"
    },
    "inputs": {
      "type": "object",
      "required": [
        "brief",
        "concept",
        "assets"
      ],
      "properties": {
        "brief": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "concept": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "approvers": {
      "type": "object",
      "required": [
        "creative",
        "logistics",
        "release"
      ],
      "properties": {
        "creative": {
          "type": "string",
          "minLength": 1
        },
        "logistics": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requestedAt": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  }
}
